---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../consts';
import { formatDate, getPostUrl, getPublishedPosts, isoDate } from '../utils';

const posts = await getPublishedPosts();

const schema = [
  {
    '@type': 'Blog',
    '@id': `${SITE_URL}/#blog`,
    name: SITE_TITLE,
    description: SITE_DESCRIPTION,
    url: `${SITE_URL}/`,
    inLanguage: 'en',
    publisher: { '@id': `${SITE_URL}/#organization` },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      '@id': `${new URL(getPostUrl(post), SITE_URL).toString()}#article`,
      headline: post.data.title,
      description: post.data.description,
      datePublished: isoDate(post.data.publishedAt),
      dateModified: isoDate(post.data.updatedAt ?? post.data.publishedAt),
      author: { '@type': 'Person', name: post.data.author },
      url: new URL(getPostUrl(post), SITE_URL).toString(),
    })),
  },
];
---

<BaseLayout title="Rasa Ecology Blog" description={SITE_DESCRIPTION} schema={schema}>
  <section class="hero">
    <h1>Practical ecology for living soil.</h1>
    <p>
      Field notes and clear guides on compost, soil biology, biodiversity, and regenerative
      growing for people building healthier landscapes.
    </p>
  </section>

  <section aria-labelledby="latest-posts">
    <h2 class="section-heading" id="latest-posts">Latest writing</h2>
    <div class="post-grid">
      {
        posts.map((post) => (
          <article class="post-card">
            {post.data.heroImage && (
              <img
                class="post-card__image"
                src={post.data.heroImage}
                alt={post.data.heroImageAlt ?? ''}
                loading="lazy"
              />
            )}
            <div class="post-card__body">
              <div class="meta">
                <time datetime={isoDate(post.data.publishedAt)}>
                  {formatDate(post.data.publishedAt)}
                </time>
                <span>{post.data.author}</span>
              </div>
              <h3>
                <a href={getPostUrl(post)}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <ul class="tag-list" aria-label="Post tags">
                  {post.data.tags.map((tag) => (
                    <li>
                      <a href={`/tags/${tag.toLowerCase().replaceAll(' ', '-')}/`}>{tag}</a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
