---
import BaseLayout from '../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { formatDate, getPostSlug, getPostUrl, getPublishedPosts } from '../utils';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth >= 1 && heading.depth <= 3);
const canonicalUrl = post.data.canonicalUrl ?? new URL(getPostUrl(post), Astro.site).toString();
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalUrl={canonicalUrl}
  ogTitle={post.data.ogTitle ?? post.data.title}
  ogDescription={post.data.ogDescription ?? post.data.description}
  ogImage={post.data.ogImage ?? post.data.heroImage}
>
  <article class="article">
    {
      tocHeadings.length > 1 && (
        <>
          <button
            class="toc-fab"
            type="button"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="toc-modal"
            aria-label="Open table of contents"
          >
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="4" y1="7" x2="20" y2="7" />
              <line x1="4" y1="12" x2="20" y2="12" />
              <line x1="4" y1="17" x2="20" y2="17" />
            </svg>
          </button>

          <div class="toc-modal" id="toc-modal" role="dialog" aria-modal="true" aria-label="On this page">
            <div class="toc-modal__backdrop" data-toc-close />
            <div class="toc-modal__panel">
              <button class="toc-modal__close" type="button" data-toc-close aria-label="Close table of contents">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <line x1="6" y1="6" x2="18" y2="18" />
                  <line x1="18" y1="6" x2="6" y2="18" />
                </svg>
              </button>
              <p class="toc-modal__title">On this page</p>
              <ul class="toc-list">
                {tocHeadings.map((heading, index) => (
                  <li class={`toc-list__item toc-list__item--d${heading.depth}`} style={`--ray-index: ${index}`}>
                    <a href={`#${heading.slug}`} data-toc-close>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </>
      )
    }
    <header class="article-header">
      <h1>{post.data.title}</h1>
      <div class="meta">
        by <a href={`/authors/${post.data.author.toLowerCase()}/`}>{post.data.author}</a> | 
        <span>{formatDate(post.data.publishedAt)}</span>
      </div>
    </header>

    {
      post.data.heroImage && (
        <img
          class="article-hero"
          src={post.data.heroImage}
          alt={post.data.heroImageAlt ?? ''}
        />
      )
    }

    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  const tocFab = document.querySelector<HTMLButtonElement>('.toc-fab');
  const tocModal = document.querySelector<HTMLElement>('.toc-modal');

  if (tocFab && tocModal) {
    const openModal = () => {
      tocModal.classList.add('is-open');
      tocFab.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      tocModal.querySelector<HTMLButtonElement>('.toc-modal__close')?.focus();
    };

    const closeModal = (returnFocus = true) => {
      if (!tocModal.classList.contains('is-open')) return;
      tocModal.classList.remove('is-open');
      tocFab.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (returnFocus) tocFab.focus();
    };

    tocFab.addEventListener('click', openModal);

    tocModal.addEventListener('click', (event) => {
      const closer = (event.target as Element).closest('[data-toc-close]');
      if (!closer) return;
      closeModal(closer.tagName !== 'A');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeModal();
    });

    // Scroll-spy: highlight the section currently in view.
    const links = Array.from(tocModal.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    if (links.length > 0) {
      const linkByHeading = new Map<Element, HTMLAnchorElement>();
      for (const link of links) {
        const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        if (heading) linkByHeading.set(heading, link);
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const link = linkByHeading.get(entry.target);
            if (!link) continue;
            for (const other of links) other.classList.toggle('is-active', other === link);
          }
        },
        { rootMargin: '0px 0px -80% 0px', threshold: 0 },
      );

      for (const heading of linkByHeading.keys()) observer.observe(heading);
    }
  }
</script>
