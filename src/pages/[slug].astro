---
import BaseLayout from '../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { DEFAULT_OG_IMAGE, SITE_TITLE, SITE_URL } from '../consts';
import { formatDate, getPostSlug, getPostUrl, getRoutablePosts, isoDate } from '../utils';

export async function getStaticPaths() {
  const posts = await getRoutablePosts();

  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth >= 1 && heading.depth <= 3);
const canonicalUrl = post.data.canonicalUrl ?? new URL(getPostUrl(post), Astro.site).toString();

const isPreview = post.data.status === 'Preview';
const authorUrl = new URL(`/authors/${post.data.author.toLowerCase()}/`, SITE_URL).toString();
const publishedAt = post.data.publishedAt;
const updatedAt = post.data.updatedAt ?? publishedAt;
const socialImage = post.data.ogImage ?? post.data.heroImage ?? DEFAULT_OG_IMAGE;
const absoluteImage = socialImage.startsWith('http')
  ? socialImage
  : new URL(socialImage, SITE_URL).toString();

// Google truncates headline past ~110 characters and flags longer ones.
const headline =
  post.data.title.length > 110 ? `${post.data.title.slice(0, 109).trimEnd()}…` : post.data.title;

const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${canonicalUrl}#article`,
    headline,
    name: post.data.title,
    description: post.data.description,
    datePublished: isoDate(publishedAt),
    dateModified: isoDate(updatedAt),
    author: {
      '@type': 'Person',
      '@id': `${authorUrl}#person`,
      name: post.data.author,
      url: authorUrl,
    },
    publisher: { '@id': `${SITE_URL}/#organization` },
    isPartOf: { '@id': `${SITE_URL}/#website` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    image: absoluteImage,
    inLanguage: 'en',
    wordCount: post.body?.trim().split(/\s+/).filter(Boolean).length,
    ...(post.data.tags.length > 0 && {
      keywords: post.data.tags,
      articleSection: post.data.tags[0],
    }),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE_TITLE, item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: post.data.title, item: canonicalUrl },
    ],
  },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalUrl={canonicalUrl}
  ogTitle={post.data.ogTitle ?? post.data.title}
  ogDescription={post.data.ogDescription ?? post.data.description}
  ogImage={socialImage}
  ogType="article"
  noindex={isPreview}
  article={{
    publishedTime: isoDate(publishedAt),
    modifiedTime: isoDate(updatedAt),
    author: post.data.author,
    tags: post.data.tags,
  }}
  schema={isPreview ? [] : schema}
>
  <article class="article">
    {
      tocHeadings.length > 1 && (
        <>
          <button
            class="toc-fab"
            type="button"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="toc-modal"
            aria-label="Open table of contents"
          >
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="4" y1="7" x2="20" y2="7" />
              <line x1="4" y1="12" x2="20" y2="12" />
              <line x1="4" y1="17" x2="20" y2="17" />
            </svg>
          </button>

          <div class="toc-modal" id="toc-modal" role="dialog" aria-modal="true" aria-label="On this page">
            <div class="toc-modal__backdrop" data-toc-close />
            <div class="toc-modal__panel">
              <button class="toc-modal__close" type="button" data-toc-close aria-label="Close table of contents">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <line x1="6" y1="6" x2="18" y2="18" />
                  <line x1="18" y1="6" x2="6" y2="18" />
                </svg>
              </button>
              <p class="toc-modal__title">On this page</p>
              <ul class="toc-list">
                {tocHeadings.map((heading, index) => (
                  <li class={`toc-list__item toc-list__item--d${heading.depth}`} style={`--ray-index: ${index}`}>
                    <a href={`#${heading.slug}`} data-toc-close>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </>
      )
    }
    {
      isPreview && (
        <p class="preview-banner" role="status">
          <strong>Preview.</strong> This post is not published yet. It is hidden from the
          homepage, the feed, and search engines until its status in Notion is set to Done.
        </p>
      )
    }

    <header class="article-header">
      <h1>{post.data.title}</h1>
      <div class="meta">
        by <a href={`/authors/${post.data.author.toLowerCase()}/`} rel="author">{post.data.author}</a> |
        <time datetime={isoDate(publishedAt)}>{formatDate(publishedAt)}</time>
        {
          updatedAt.valueOf() !== publishedAt.valueOf() && (
            <span>
              {' '}(updated <time datetime={isoDate(updatedAt)}>{formatDate(updatedAt)}</time>)
            </span>
          )
        }
      </div>
    </header>

    {
      post.data.heroImage && (
        <img
          class="article-hero"
          src={post.data.heroImage}
          alt={post.data.heroImageAlt ?? ''}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )
    }

    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  const tocFab = document.querySelector<HTMLButtonElement>('.toc-fab');
  const tocModal = document.querySelector<HTMLElement>('.toc-modal');

  if (tocFab && tocModal) {
    const openModal = () => {
      tocModal.classList.add('is-open');
      tocFab.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      tocModal.querySelector<HTMLButtonElement>('.toc-modal__close')?.focus();
    };

    const closeModal = (returnFocus = true) => {
      if (!tocModal.classList.contains('is-open')) return;
      tocModal.classList.remove('is-open');
      tocFab.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (returnFocus) tocFab.focus();
    };

    tocFab.addEventListener('click', openModal);

    tocModal.addEventListener('click', (event) => {
      const closer = (event.target as Element).closest('[data-toc-close]');
      if (!closer) return;
      closeModal(closer.tagName !== 'A');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeModal();
    });

    // Scroll-spy: highlight the section currently in view.
    const links = Array.from(tocModal.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    if (links.length > 0) {
      const linkByHeading = new Map<Element, HTMLAnchorElement>();
      for (const link of links) {
        const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        if (heading) linkByHeading.set(heading, link);
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const link = linkByHeading.get(entry.target);
            if (!link) continue;
            for (const other of links) other.classList.toggle('is-active', other === link);
          }
        },
        { rootMargin: '0px 0px -80% 0px', threshold: 0 },
      );

      for (const heading of linkByHeading.keys()) observer.observe(heading);
    }
  }
</script>
