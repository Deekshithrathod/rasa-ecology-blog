---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../utils';

const posts = await getPublishedPosts();
const tags = Array.from(new Set(posts.flatMap((post) => post.data.tags))).sort((a, b) =>
  a.localeCompare(b),
);
---

<BaseLayout title="Tags" description="Browse Rasa Ecology articles by topic.">
  <h1 class="section-heading">Tags</h1>
  <ul class="tag-list">
    {
      tags.map((tag) => (
        <li>
          <a href={`/tags/${tag.toLowerCase().replaceAll(' ', '-')}/`}>{tag}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
