---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../consts';
import { formatDate, getPostUrl, getPublishedPosts, isoDate } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const authors = Array.from(new Set(posts.map((post) => post.data.author)));

  return authors.map((author) => ({
    params: { author: author.toLowerCase() },
    props: {
      author,
      posts: posts.filter((post) => post.data.author === author),
    },
  }));
}

const { author, posts } = Astro.props;
const authorUrl = new URL(`/authors/${author.toLowerCase()}/`, SITE_URL).toString();

// The Person node is what ties every BlogPosting's author back to a real page
// on this site, which is the part search engines and LLMs use for attribution.
const schema = [
  {
    '@type': 'ProfilePage',
    '@id': `${authorUrl}#profile`,
    url: authorUrl,
    name: `Posts by ${author}`,
    isPartOf: { '@id': `${SITE_URL}/#website` },
    mainEntity: { '@id': `${authorUrl}#person` },
  },
  {
    '@type': 'Person',
    '@id': `${authorUrl}#person`,
    name: author,
    url: authorUrl,
    worksFor: { '@id': `${SITE_URL}/#organization` },
  },
];
---

<BaseLayout
  title={`Posts by ${author}`}
  description={`Rasa Ecology articles by ${author}.`}
  canonicalUrl={authorUrl}
  schema={schema}
>
  <h1 class="section-heading">Posts by {author}</h1>
  <div class="listing">
    {
      posts.map((post) => (
        <article>
          <div class="meta">
            <time datetime={isoDate(post.data.publishedAt)}>
              {formatDate(post.data.publishedAt)}
            </time>
          </div>
          <h2>
            <a href={getPostUrl(post)}>{post.data.title}</a>
          </h2>
          <p>{post.data.description}</p>
        </article>
      ))
    }
  </div>
</BaseLayout>
