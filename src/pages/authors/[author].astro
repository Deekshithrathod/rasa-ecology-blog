---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPostUrl, getPublishedPosts } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const authors = Array.from(new Set(posts.map((post) => post.data.author)));

  return authors.map((author) => ({
    params: { author: author.toLowerCase() },
    props: {
      author,
      posts: posts.filter((post) => post.data.author === author),
    },
  }));
}

const { author, posts } = Astro.props;
---

<BaseLayout title={`Posts by ${author}`} description={`Rasa Ecology articles by ${author}.`}>
  <h1 class="section-heading">Posts by {author}</h1>
  <div class="listing">
    {
      posts.map((post) => (
        <article>
          <div class="meta">
            <span>{formatDate(post.data.publishedAt)}</span>
          </div>
          <h2>
            <a href={getPostUrl(post)}>{post.data.title}</a>
          </h2>
          <p>{post.data.description}</p>
        </article>
      ))
    }
  </div>
</BaseLayout>
