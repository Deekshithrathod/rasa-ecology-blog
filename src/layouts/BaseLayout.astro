---
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  twitterImage?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  canonicalUrl = Astro.url.href,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/og-image.png',
  twitterImage = '/og-twitter-image.png',
} = Astro.props;

const pageTitle = title === SITE_TITLE ? SITE_TITLE : `${title} | ${SITE_TITLE}`;
const absoluteOgImage = ogImage?.startsWith('http')
  ? ogImage
  : ogImage
    ? new URL(ogImage, SITE_URL).toString()
    : undefined;
const absoluteTwitterImage = twitterImage?.startsWith('http')
  ? twitterImage
  : twitterImage
    ? new URL(twitterImage, SITE_URL).toString()
    : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fbfbf7" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    {absoluteTwitterImage && <meta name="twitter:image" content={absoluteTwitterImage} />}
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:card" content={absoluteOgImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <nav class="site-nav" aria-label="Main navigation">
          <a class="brand" href="/">
            <img class="brand__icon" src="/logo/rasa-logo-mark-header-48.png" alt="" width="36" height="48" />
            <span>Rasa Ecology</span>
          </a>
          <div class="nav-links">
            <a href="/tags/">Tags</a>
            <a href="/rss.xml">RSS</a>
          </div>
        </nav>
      </header>
      <main class="site-main">
        <slot />
      </main>
      <footer class="site-footer">
        <span>Rasa Ecology Blog. Practical writing for living soil and ecological growing.</span>
      </footer>
    </div>
  </body>
</html>
